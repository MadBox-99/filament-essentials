{
    "name": "madbox-99/filament-essentials",
    "description": "Sensible defaults for Filament: translated labels on every field, entry and column, plus optional component defaults.",
    "keywords": ["filament", "laravel", "translation", "labels", "defaults"],
    "license": "MIT",
    "authors": [
        {
            "name": "Zoltán Tamás Szabó",
            "email": "zoli.szabok@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "MadBox99\\FilamentEssentials\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MadBox99\\FilamentEssentials\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MadBox99\\FilamentEssentials\\FilamentEssentialsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "format": "vendor/bin/pint"
    },
    "prefer-stable": true
}
